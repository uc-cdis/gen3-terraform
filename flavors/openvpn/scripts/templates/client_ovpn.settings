client
dev tun
proto tcp
remote $EXTHOST 1194
resolv-retry infinite
nobind
persist-key
persist-tun

# Must line up with the server. It advertises AES-256-GCM and negotiates via
# data-ciphers; leaving the old "cipher AES-256-CBC" here made clients ask for a
# cipher the server no longer prefers.
data-ciphers AES-256-GCM:AES-128-GCM
data-ciphers-fallback AES-256-CBC

# No "auth" here either. It sets the tls-auth HMAC digest, which has to match the server
# exactly, and the server stays on the SHA1 default so the configs already issued keep
# working. Change both sides together, never one.

# comp-lzo has to match the server, which keeps it on for the configs already in
# circulation. Without it here the tunnel comes up but no data passes: the server
# expects the compression framing byte and drops every packet. VORACLE risk, so it
# goes from both sides together once the old configs are reissued.
comp-lzo

# remote-cert-tls replaces ns-cert-type, which is deprecated and removed in
# newer clients. Same effect: refuse to connect to something that is not a server cert.
remote-cert-tls server

verb 4
key-direction 1
auth-user-pass

# TOTP based auth, so the credentials cannot be reused on renegotiation. The server
# sets reneg-sec 43200 and openvpn takes the lower of the two, so 0 here means the
# server's value wins rather than forcing a reauth mid session.
reneg-sec 0
